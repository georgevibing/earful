{
  "name": "earful",
  "private": true,
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "pnpm --filter @earful/widget build && pnpm --filter @earful/admin build",
    "build": "pnpm build:web && cargo build --release",
    "dev:server": "cargo run -p earful -- serve",
    "dev:admin": "pnpm --filter @earful/admin dev",
    "typecheck": "pnpm -r typecheck",
    "test:web": "pnpm -r --filter=!@earful/e2e test",
    "test:rust": "cargo test --workspace",
    "test:e2e": "pnpm build:web && cargo build && pnpm --filter @earful/e2e test",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "check": "pnpm typecheck && pnpm lint:rust && pnpm test:rust && pnpm test:web && pnpm test:e2e",
    "screenshots": "pnpm build:web && cargo build && node scripts/screenshots.mjs"
  }
}
