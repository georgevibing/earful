# earful configuration. Copy to .env and fill in. Never commit .env.
#
# Quoting rule for docker compose: values containing `$` (argon2 hashes do) MUST be
# wrapped in single quotes here. Compose interpolates unquoted and double quoted
# .env values, which would mangle the hash. Single quoted values stay literal.
# (If you write the hash directly into docker-compose.yml instead, escape every
# `$` as `$$`.)

# --- Admin auth -------------------------------------------------------------
# Generate with:  printf '%s' 'your-password' | cargo run -q -p earful -- hash-password
#           or:  printf '%s' 'your-password' | docker run --rm -i earful:local hash-password
# Unset means every admin login is rejected (fail closed).
EARFUL_ADMIN_PASSWORD_HASH=''
# Alternative: path to a file holding the hash (takes precedence over the variable).
# EARFUL_ADMIN_PASSWORD_HASH_FILE=/run/secrets/earful_admin_password_hash
# Session lifetime in hours (default 168 = 7 days).
# EARFUL_SESSION_TTL_HOURS=168
# Mark the session cookie Secure (default true). Only set false for plain http on localhost.
# EARFUL_COOKIE_SECURE=true

# --- Network ------------------------------------------------------------------
# Listen address. Default 127.0.0.1:8080; the Docker image sets 0.0.0.0:8080 inside the container.
# EARFUL_BIND=127.0.0.1:8080
# Reverse proxies in front of the app whose X-Forwarded-For entries are trusted.
# 0 = none (direct), 1 = Coolify Traefik/Caddy, 2 = Cloudflare proxy + Coolify proxy.
# EARFUL_TRUSTED_PROXY_HOPS=0

# --- Storage -------------------------------------------------------------------
# EARFUL_DATABASE_PATH=earful.db

# --- Anti-spam ------------------------------------------------------------------
# Rate limits (sliding windows, counted per hashed IP).
# EARFUL_LIMIT_IP_PROJECT_MINUTE=3
# EARFUL_LIMIT_IP_PROJECT_HOUR=10
# EARFUL_LIMIT_IP_PROJECT_DAY=30
# EARFUL_LIMIT_IP_GLOBAL_DAY=60
# Cap per project across all IPs (flood guard).
# EARFUL_LIMIT_PROJECT_HOUR=300
# Beyond the flood guard submissions are quarantined; at 3x they are refused.
# Total submissions per day across all projects (protects the disk).
# EARFUL_LIMIT_GLOBAL_DAY=5000
# Quarantined (spam) items older than this many days are purged; 0 keeps them.
# EARFUL_SPAM_RETENTION_DAYS=30
# EARFUL_LIMIT_CHALLENGES_IP_HOUR=60
# Submissions arriving sooner than this after the challenge was issued are quarantined.
# EARFUL_MIN_FILL_SECS=2
# Heuristic spam score at or above which a submission goes to the spam bucket.
# EARFUL_SPAM_THRESHOLD=0.7
# Proof of work difficulty (leading zero bits). Base is adaptive up to the max.
# EARFUL_POW_BITS=18
# EARFUL_POW_MAX_BITS=23
# EARFUL_CHALLENGE_TTL_SECS=1800

# --- Embeddings (semantic search) ---------------------------------------------
# auto (default): model2vec when EARFUL_EMBED_MODEL_PATH holds a model, else hash
# model2vec: local static embeddings, real semantic search, offline (fetch the
#            model once with `earful download-model`; bundled in Docker)
# hash:      offline, lexical with a small concept map
# openai:    any OpenAI compatible /embeddings API (OpenAI, Ollama, ...)
# none:      semantic search off
# EARFUL_EMBED_PROVIDER=auto
# EARFUL_EMBED_MODEL_PATH=models/potion-base-8M
# EARFUL_EMBED_AUTO_DOWNLOAD=false
# EARFUL_EMBED_DIM=384
# EARFUL_EMBED_URL=https://api.openai.com/v1
# EARFUL_EMBED_MODEL=text-embedding-3-small   (openai) or a Hugging Face repo id (model2vec auto download)
# EARFUL_EMBED_API_KEY=
# EARFUL_EMBED_API_KEY_FILE=/run/secrets/earful_embed_api_key

# --- Logging ---------------------------------------------------------------------
# RUST_LOG=info
